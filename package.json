{
  "name": "campus-career",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "cert": "node scripts/generate-cert.mjs",
    "setup:https": "npm run cert && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/add-dev-host.ps1",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "blocks:model": "node scripts/generate-blocks-model.mjs",
    "blocks:security": "node scripts/generate-blocks-security.mjs",
    "blocks:seed": "node scripts/seed-campuscareer-demo.mjs",
    "blocks:verify-demo": "node scripts/check-campuscareer-demo-access.mjs",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hookform/resolvers": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-dropdown-menu": "latest",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "latest",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@seliseblocks/client": "^0.2.0",
    "@tanstack/react-query": "latest",
    "ajv": "^8.20.0",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "latest",
    "react-router-dom": "latest",
    "sonner": "latest",
    "tailwind-merge": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "prettier": "^3.9.6",
    "selfsigned": "^5.5.0",
    "tailwindcss": "latest",
    "tw-animate-css": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest"
  }
}
